    "app_browser_install_warning_brand_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On brand-specific devices (such as Xiaomi, OnePlus, Realme, etc.), you must explicitly accept the security prompt that appears on your phone screen during the installation process."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샤오미, 원플러스, 리얼미 등 일부 브랜드 기기에서는 설치 과정 중 화면에 나타나는 보안 프롬프트를 반드시 직접 수락해야 합니다."
          }
        }
      }
    },
    "app_browser_install_warning_step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To successfully install APKs, ensure USB Debugging and Install via USB (if available) are enabled in your device's Developer Options."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "APK를 정상적으로 설치하려면 기기의 개발자 옵션에서 'USB 디버깅' 및 'USB를 통한 설치'(지원되는 경우)를 켜 두어야 합니다."
          }
        }
      }
    },
    "app_browser_install_warning_step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Additionally, a confirmation popup will appear on your device screen. You must tap 'Install' or 'Accept' on the device to complete the installation."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또한 설치 진행 중 기기 화면에 확인 팝업이 표시됩니다. 기기에서 '설치' 또는 '허용'을 직접 눌러야 설치가 완료됩니다."
          }
        }
      }
    },
